# ローカル開発用。このファイルをコピーして .env.local を作成し、実際の値を入れてください。
# cp .env.example .env.local

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 任意。省略時は "class-demo"
VITE_CLASS_ID=class-demo

# 任意。設定するとクライアントの未捕捉エラーが Sentry に送られる。
# 児童 PII (email / displayName) は送られないよう beforeBreadcrumb で剥がしている。
# 未設定なら監視オフ (開発体験を阻害しない)。
VITE_SENTRY_DSN=
