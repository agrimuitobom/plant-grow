rules_version = '2';

// 植物生育管理アプリ用ルール。
// - Google ログイン (匿名以外) でサインインしている利用者のみ読み書き可能。
// - 書き込み時、ドキュメントのスキーマを軽くバリデーションする。
// - 1レコード = 1日分。doc id は YYYY-MM-DD 形式のみ許可。
// - 教員 (classes/{classId}/teachers/{uid}) は同じクラスの全生徒を読み取りできる。
//   教員ドキュメントは Firebase Console から手動で追加する運用。
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isValidDateId(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidRecord(data) {
      return data.keys().hasAll(['date', 'strains', 'averages'])
        && data.date is string
        && data.strains is list
        && data.strains.size() > 0
        && data.strains.size() <= 50
        && data.averages is map;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasAuditFields(data, userId) {
      return data.createdBy == userId
        && data.updatedBy == userId;
    }

    // 教員ロールの判定。exists() は Rules を再帰的に評価しないので O(1)。
    function isTeacher(classId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/classes/$(classId)/teachers/$(request.auth.uid));
    }

    // 年度アーカイブ判定。
    // クラスメタドキュメント (classes/{classId}) は setClassArchived Function だけが書く。
    // メタドキュメントが存在しない (= 運用中のクラス) 場合は必ず false を返すよう
    // exists() で先にガードする (存在しない doc の .data 参照は評価エラーになるため)。
    function isClassArchived(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.archived == true;
    }

    // クラスメタドキュメント (アーカイブ状態など)。
    // 読み取りはサインイン済み全員 (アプリ起動時に「この年度は凍結済みか」を出すため)。
    // 書き込みは setClassArchived Function のみ → auditLog に必ず痕跡が残る。
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 教員ドキュメント。
    // - 任意のサインイン済みユーザに read を許可 (自分が教員か検出する目的)。
    // - 書き込みは全て Cloud Function 経由 (Admin SDK で Rules バイパス) に統一:
    //     * 最初の 1 人 : claimFirstTeacher Function
    //     * 昇格         : promoteTeacher Function
    //     * 解除         : demoteTeacher Function (自分自身は対象外)
    //   こうすることで全ての教員ロール変更が auditLog に必ず残る。
    match /classes/{classId}/teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // パスワードリセット監査ログ。Cloud Function (Admin SDK) のみが書き込み、
    // 同クラスの教員が読み取り可能 (誰がいつ誰のパスワードを再発行したかの監査用)。
    match /classes/{classId}/passwordResets/{logId} {
      allow read: if isTeacher(classId);
      allow write: if false; // Function 経由のみ (Admin SDK で Rules バイパス)
    }

    // 統合監査ログ。Cloud Function 経由の特権操作 (パスワードリセット / 共有リンク発行・取消 /
    // 初代教員登録など) が成功した時に Admin SDK で 1 エントリ追記する。
    // クライアント書き込みは完全禁止 → 改ざんできない監査エビデンスとして機能する。
    match /classes/{classId}/auditLog/{logId} {
      allow read: if isTeacher(classId);
      allow write: if false;
    }

    // クラス名簿。生徒は自分のエントリだけ upsert でき、
    // 同じクラスの教員は全員分を一覧できる。
    // アーカイブ済み年度は名簿も凍結 (新規参加・表示名変更ともに不可)。
    match /classes/{classId}/students/{userId} {
      allow read: if isOwner(userId) || isTeacher(classId);
      allow create, update: if isOwner(userId)
        && !isClassArchived(classId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'displayName']);
      allow delete: if false;
    }

    // 各生徒は自分の領域だけ R/W 可能。教員は read だけ可能 (書き込みは本人限定)。
    // 監査用に createdBy / updatedBy を記録する (パスの uid と一致を強制)。
    // アーカイブ済み年度への書き込みは全面凍結 (読み取りは従来通り)。
    match /classes/{classId}/students/{userId}/records/{dateId} {
      allow read: if isOwner(userId) || isTeacher(classId);
      allow create, update: if isOwner(userId)
        && !isClassArchived(classId)
        && isValidDateId(dateId)
        && isValidRecord(request.resource.data)
        && hasAuditFields(request.resource.data, userId);
      allow delete: if false; // 誤操作防止のため UI では削除させない

      // 編集履歴: 上書き保存の直前にスナップショットを残す。
      // 不変アーカイブとして create のみ許可、update/delete はクライアントから不可。
      match /history/{historyId} {
        allow read: if isOwner(userId) || isTeacher(classId);
        allow create: if isOwner(userId) && !isClassArchived(classId);
        allow update, delete: if false;
      }

      // 教員から生徒へのフィードバックコメント。
      // - 生徒は自分のレコードに付いたコメントを read のみ可。
      // - 教員のみ書き込み可、各教員は自分の作成したコメントだけ編集・削除可。
      // - text は 1〜1000 文字。アーカイブ済み年度はコメントも凍結。
      match /comments/{commentId} {
        allow read: if isOwner(userId) || isTeacher(classId);
        allow create: if isTeacher(classId)
          && !isClassArchived(classId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasAll(['text', 'createdBy', 'createdByName'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if isTeacher(classId)
          && !isClassArchived(classId)
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow delete: if isTeacher(classId)
          && !isClassArchived(classId)
          && resource.data.createdBy == request.auth.uid;
      }
    }

    // 観察イベント (水やり / 肥料 / 天気)。
    // 草丈グラフとは独立したタイムライン。生徒が追加・削除可、教員は read のみ。
    // update は禁止 (誤編集を防ぐため追記オンリー運用)。
    match /classes/{classId}/students/{userId}/events/{eventId} {
      allow read: if isOwner(userId) || isTeacher(classId);
      allow create: if isOwner(userId)
        && !isClassArchived(classId)
        && request.resource.data.createdBy == userId
        && request.resource.data.date is string
        && isValidDateId(request.resource.data.date)
        && request.resource.data.type in [
          'water', 'fertilizer',
          'weather-sunny', 'weather-cloudy', 'weather-rain', 'weather-storm'
        ];
      allow update: if false;
      allow delete: if isOwner(userId) && !isClassArchived(classId);
    }

    // 保護者向け共有スナップショット。
    // - Cloud Function (Admin SDK) のみが書き込み (クライアント write は完全禁止)
    // - 期限内 (expiresAt > 現在時刻) なら token を知っている誰でも read 可能 (未認証 OK)
    //   = 保護者面談・参観で URL を渡してブラウザで開いてもらう想定
    // - expiresAt 切れの doc は読み取り不可になる (TTL を Rules で強制)
    match /shares/{token} {
      allow read: if resource.data.expiresAt > request.time;
      allow write: if false;
    }

    // それ以外は全拒否 (デフォルト)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
